# Copy this file to .env and fill in the values. See README.md for details.

DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=public"

# From @BotFather. Required for real Telegram auth (HMAC verification of initData).
TELEGRAM_BOT_TOKEN=

# Random 32+ byte string used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# How old a Telegram initData payload can be before it's rejected (seconds).
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Dev-only fallback auth for testing outside Telegram. Never true in production —
# it's also hard-gated by NODE_ENV !== "production" server-side regardless of this flag.
ALLOW_MOCK_TELEGRAM_AUTH=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret required (as an `x-cron-secret` header) to call POST /api/cron/reminders.
CRON_SECRET=
